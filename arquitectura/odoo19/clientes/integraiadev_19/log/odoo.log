                            env: odoo.__WOWL__.services
                        });
                        app.mount(root).then(() =&gt; {
                            console.log("✅ AddressAutofill mounted successfully");
                        });
                    }

                    // Esperar a que el checkout esté listo
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', mountAutofill);
                    } else {
