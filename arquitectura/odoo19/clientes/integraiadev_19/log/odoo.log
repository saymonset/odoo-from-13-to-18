                (function() {
                    function mountAutofill() {
                        const root = document.getElementById('address_autofill_root');
                        if (!root || root.hasAttribute('data-mounted')) return;
                        
                        root.setAttribute('data-mounted', 'true');

                        const Component = odoo.__WOWL__.public_components.get('bcv_rate_update_venezuela.AddressAutofill');
                        if (!Component) {
                            console.warn("AddressAutofill component not found");
                            return;
                        }

                        const app = new odoo.__WOWL__.App(Component, {
                            env: odoo.__WOWL__.services
                        });
                        app.mount(root).then(() =&gt; {
                            console.log("✅ AddressAutofill mounted successfully");
                        });
                    }

                    // Esperar a que el checkout esté listo
                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', mountAutofill);
                    } else {
                        setTimeout(mountAutofill, 800); // pequeño delay para que renderice Odoo
                    }
                })();
