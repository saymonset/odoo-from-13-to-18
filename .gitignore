# =======================================
# Respaldos y datos de clientes
# =======================================
/arquitectura/odoo*/clientes/*/respaldo_db/
/arquitectura/odoo*/clientes/*/data/
/arquitectura/odoo*/clientes/*/respaldo_odoo/
/arquitectura/odoo*/backup/out/

# =======================================
# Ignorar directorios de pruebas y PostgreSQL (evita "Permission denied")
# =======================================
/arquitectura/odoo19/v19test/
**/pgdata/
**/test_pgdata/

# Excepciones para mantener estructura vacía
!/arquitectura/odoo*/backup/out/.gitkeep
!/arquitectura/odoo*/backup/out/README.md

# =======================================
# Entornos virtuales y código fuente Odoo
# =======================================
/arquitectura/odoo*/.venv
/arquitectura/odoo*/odoo

# =======================================
# Carpetas de clientes (log, enterprise, oca, etc.)
# =======================================
/arquitectura/odoo*/clientes/*/log/
/arquitectura/odoo*/clientes/*/extra-addons/enterprise
/arquitectura/odoo*/clientes/*/extra-addons/oca/
/arquitectura/odoo*/clientes/*/extra-addon/

# =======================================
# Archivos generados por Odoo (filestore, sessions, etc.)
# =======================================
/arquitectura/odoo*/clientes/*/data/filestore/
/arquitectura/odoo*/clientes/*/data/sessions/
/arquitectura/odoo*/clientes/*/sessions/

# =======================================
# Excepciones para integraiadev_19 (solo estructura)
# =======================================
!/arquitectura/odoo19/clientes/integraiadev_19/data/
!/arquitectura/odoo19/clientes/integraiadev_19/data/.gitkeep
!/arquitectura/odoo19/clientes/integraiadev_19/log/
!/arquitectura/odoo19/clientes/integraiadev_19/log/.gitkeep

# =======================================
# Archivos específicos generados (react, etc.)
# =======================================
/arquitectura/odoo*/clientes/cliente1/extra-addons/extra/react-odoo/generated/
!/arquitectura/odoo*/clientes/cliente1/extra-addons/extra/react-odoo/generated/.gitkeep

# =======================================
# Archivos de Python compilados y temporales
# =======================================
**/__pycache__/
**/*.pyc
*.log
*.pid
*.lock
nohup.out

# =======================================
# Secretos y contraseñas
# =======================================
/arquitectura/odoo*/secrets/*.txt
/arquitectura/odoo*/secrets/*.key
arquitectura/odoo18/debugpy_bootstrap.py
arquitectura/odoo19/nohup.out
